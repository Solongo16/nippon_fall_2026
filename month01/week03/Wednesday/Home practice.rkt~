;;EX10

;; count-images : List-of-images -> Number
(require 2htdp/image)

(define (count-images l)
  (cond
    [(empty? l) 0]
    [else 
       (+ 1 (count-images (rest l)))]))

(check-expect (count-images empty) 0)
(check-expect (count-images
     (cons (circle 5 "solid" "red")
          (cons (circle 10 "solid" "blue") empty))) 2)

