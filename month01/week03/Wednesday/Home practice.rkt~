     [(empty? (rest l)) (first l)]
        [else
         (last-item-2 (rest l))]))     

(check-expect (last-item-2 (cons 9 empty)) 9)
(check-expect (last-item-2 (cons 2 (cons 5 (cons 8 empty)))) 8)

